{
  "name": "monix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -b",
    "db:migrate": "wrangler d1 migrations apply monix --remote",
    "db:migrate:local": "wrangler d1 migrations apply monix --local",
    "cf-typegen": "wrangler types",
    "secrets:upload": "bash scripts/upload-secrets.sh",
    "agent:install": "bash scripts/install-agent.sh"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "hono": "^4.12.25",
    "lucide-react": "^1.25.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.46.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.12",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "wrangler": "^4.152.0"
  }
}
